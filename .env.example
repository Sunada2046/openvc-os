# OpenVC OS has no API, MCP, identity-provider, or data-source presets.
# Copy this file to .env.local only when overriding local defaults.

OPENVC_HOST="127.0.0.1"
OPENVC_PORT="8787"
OPENVC_DB_PATH="./storage/openvc.sqlite"
OPENVC_STORAGE_DIR="./storage"
OPENVC_UPLOAD_DIR="./storage/uploads"

# Comma-separated origins. Keep this empty behind a same-origin reverse proxy.
OPENVC_ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# Set to true only when HTTPS is enforced by the deployment.
OPENVC_COOKIE_SECURE="false"

# Optional: provide your own one-time setup token. If omitted, the API prints a
# random token in its terminal on the first start of an empty workspace.
OPENVC_SETUP_TOKEN=""

# Backup passphrases are intentionally omitted. Supply
# OPENVC_BACKUP_PASSPHRASE only for one backup or restore command.
# OPENVC_BACKUP_DIR may override the default backups directory.
